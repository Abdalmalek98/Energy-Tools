{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chiller Plant Analyzer",
  
  "version": "1.0.0",
  "identifier": "com.energytools.chillerplantanalyzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Chiller Plant Analyzer", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 620, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Energy Tools",
    "copyright": "© Energy Tools",
    "category": "Utility",
    "shortDescription": "Chilled-water plant efficiency analysis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "startMenuFolder": "Chiller Plant Analyzer",
        "compression": "lzma"
      }
    }
  }
}
