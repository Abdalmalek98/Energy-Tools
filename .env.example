# Licensing server settings (copy to /etc/lsr/server.env on the VPS, chmod 600). NO real secrets in this file.
PORT=8443
# Behind Caddy (recommended): listen on loopback and let Caddy do TLS
BEHIND_PROXY=1
# Or terminate TLS in the server itself instead of BEHIND_PROXY:
# TLS_CERT=/etc/lsr/fullchain.pem
# TLS_KEY=/etc/lsr/privkey.pem
DB_PATH=/var/lib/lsr/licensing.sqlite
# long random admin token: openssl rand -hex 32
ADMIN_TOKEN=change-me-use-openssl-rand-hex-32-change-me
# public keys that may sign activation codes (a copy of licensing/keys/production.json)
LICENSE_KEYS_FILE=/etc/lsr/production.json
# the server's own receipt-signing key (generate ON the server: scripts/gen-license-key.sh --role receipt)
RECEIPT_KEY_FILE=/etc/lsr/receipt-key.pem
RECEIPT_KID=srv-1
# optional: lets the License Manager create codes. Prefer signing on your own PC and importing.
# LICENSE_SIGNING_KEY_FILE=/etc/lsr/license-key.pem
# LICENSE_SIGNING_KID=lic-1
GRACE_HOURS=168
# page reading proxy: which provider reads the handwriting (anthropic | groq).
# You can also pick the provider and paste the API key in the License Manager (/manager → "Reading provider"); keys saved there
# are stored ENCRYPTED and win over these values.
PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_BEST=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5
# Groq (OpenAI-compatible API). Choose a model that accepts images; "Test connection" in the Manager lists what your key can use.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_BEST=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_FAST=meta-llama/llama-4-scout-17b-16e-instruct

# --- app build settings (CI variables, not secrets) ---
# LSR_SERVICE_URL=https://licensing.example.com
# LSR_SUPPORT_URL=mailto:support@example.com
# LSR_CONTACT=Contact support@example.com for an activation code.
