# License server configuration. NEVER commit a real .env.
# Signing keys: JSON map keyId -> PKCS8 PEM private key (base64 of the PEM), or a path via CPA_SIGNING_KEY_FILE_<keyId>.
CPA_ACTIVE_KEY_ID=k1
CPA_SIGNING_KEY_k1=
# Admin API bearer token (long random string). Used by License Manager only.
CPA_ADMIN_TOKEN=
CPA_DB_PATH=./data/licenses.db
CPA_PORT=8443
# Terminate TLS at a reverse proxy (recommended) or provide certificate paths:
CPA_TLS_CERT=
CPA_TLS_KEY=
# Validation policy handed to clients
CPA_CHECK_INTERVAL_DAYS=7
CPA_GRACE_DAYS=14
